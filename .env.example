APP_NAME="Packing Stok"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: SQLite (ringan, cocok untuk laptop toko)
DB_CONNECTION=sqlite
# Kalau mau pakai MySQL, uncomment di bawah dan buat database-nya dulu
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=packingstok
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Stock Control
# true = scan tetap jalan walau stok 0 (stok bisa minus), false = block kalau stok kurang
ALLOW_NEGATIVE_STOCK=false

# Auto Watch Folder — otomatis import file CSV/XLSX yang di-drop ke folder
# Kosongkan path untuk pakai default: storage/app/import/{inbox,processed,failed}
# Kalau pakai Google Drive desktop, arahkan INBOX ke folder yg di-sync, mis:
#   WATCH_FOLDER_INBOX="C:\Users\Toko\Google Drive\TikTok Orders"
WATCH_FOLDER_ENABLED=true
WATCH_FOLDER_INBOX=
WATCH_FOLDER_PROCESSED=
WATCH_FOLDER_FAILED=
# File harus sudah diam minimal N detik sebelum diproses (biar upload selesai)
WATCH_FOLDER_MIN_AGE=10
