APP_NAME="Packing Stok"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: SQLite (ringan, cocok untuk laptop toko)
DB_CONNECTION=sqlite
# Kalau mau pakai MySQL, uncomment di bawah dan buat database-nya dulu
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=packingstok
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Stock Control
# true = scan tetap jalan walau stok 0 (stok bisa minus), false = block kalau stok kurang
ALLOW_NEGATIVE_STOCK=false
